{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-shared-checkout.sh",
            "timeout": 10,
            "statusMessage": "Checking the shared checkout"
          }
        ]
      }
    ]
  }
}
